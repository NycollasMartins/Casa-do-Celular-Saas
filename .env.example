# URL e chaves do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Somente no servidor. NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publica da aplicacao (usada nos links de e-mail do Supabase Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limit distribuido (opcional). Sem estas duas, o contador cai para
# memoria: vale por instancia e nao segura abuso coordenado na Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoramento de erros (opcional). Sem DSN o Sentry fica inerte: nada e
# inicializado e nenhuma requisicao sai da aplicacao.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Necessarias apenas para enviar source map no build (stack trace legivel).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Envio do lembrete de vespera (opcional). Sem estas duas, a rotina opera em
# modo registro: anota o que teria sido enviado, sem mandar nada.
RESEND_API_KEY=
REMETENTE_EMAIL=

# WhatsApp Business Cloud API (opcional). Tem precedencia sobre o e-mail no
# lembrete de vespera. Exige conta aprovada na Meta, numero verificado e
# template homologado — texto livre fora da janela de 24h e recusado.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_vespera
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSION=v21.0
